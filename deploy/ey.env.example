# ey configuration loaded by the systemd units via EnvironmentFile.
# Every flag has an EY_* equivalent; a command-line flag overrides the
# environment, which overrides a config file (EY_CONFIG), which overrides the
# built-in default.

# Optional YAML config file. When set, both systemd units inherit these
# settings and the environment below further overrides them.
# EY_CONFIG=/etc/ey/config.yaml

# Metrics to monitor (disk, memory, cpu, process; comma-separated). A metric
# left out is neither collected, printed, nor alerted on.
# EY_METRICS=disk,memory,cpu

# Top-process metric (used when "process" is in EY_METRICS).
# EY_PROCESS_COUNT=5
# EY_PROCESS_SORT=cpu
# EY_PROCESS_THRESHOLD=90
# EY_PROCESS_COUNT_THRESHOLD=0

# Webhook delivery. Format is auto-detected from the URL host when unset.
EY_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ
# EY_FORMAT=slack

# Thresholds (percent).
EY_DISK_THRESHOLD=80
EY_MEM_THRESHOLD=90
# EY_CPU_THRESHOLD=90

# Mount point to inspect.
EY_PATH=/

# Daemon behavior (used by ey.service, which already passes -daemon).
EY_INTERVAL=60s
EY_ALERT_MODE=cooldown
EY_COOLDOWN=10m

# Webhook HTTP timeout.
EY_TIMEOUT=5s

# Webhook delivery retries (after the first attempt) and backoff base.
EY_RETRIES=3
EY_RETRY_BACKOFF=500ms

# Structured logging to stderr (json is ideal for journald).
EY_LOG_FORMAT=json
EY_LOG_LEVEL=info

# Alert state persistence. Daemon/timer units set XDG_STATE_HOME to the
# systemd StateDirectory, so the default path resolves under /var/lib/ey.
# EY_STATE_FILE=/custom/path/state.json
# EY_NO_STATE=true

